# ============================================================
# Dehkhoda RAG — environment template.  Copy to `.env` and edit.
# Every value has a safe default; nothing here is mandatory.
# ============================================================

# --- FastAPI server -----------------------------------------
DEHKHODA_HOST=127.0.0.1
DEHKHODA_PORT=8300

# --- Vector backend selection --------------------------------
# milvus  = Milvus Standalone (Docker Compose) — primary
# qdrant  = Qdrant (native binary / local persistence) — Windows fallback
# auto    = try Milvus, fall back to Qdrant automatically
DEHKHODA_BACKEND=auto

# --- Milvus ---------------------------------------------------
DEHKHODA_MILVUS_URI=http://127.0.0.1:19530
DEHKHODA_MILVUS_TOKEN=
DEHKHODA_COLLECTION_NAME=dehkhoda
# Locked: Bounded consistency
DEHKHODA_CONSISTENCY_LEVEL=Bounded

# --- Qdrant fallback (Windows without Docker) ----------------
# local  = embed persistence directory (no server process needed for tests)
# server = talk to a Qdrant server (usually the native binary sidecar)
DEHKHODA_QDRANT_MODE=local
DEHKHODA_QDRANT_PATH=./data/qdrant
DEHKHODA_QDRANT_URL=http://127.0.0.1:6333
# Optional: path of the qdrant native binary the app may auto-start
DEHKHODA_QDRANT_BINARY=

# --- Embeddings ----------------------------------------------
# e5-base = intfloat/multilingual-e5-base (768d, default, best size/quality)
# bge-m3  = BAAI/bge-m3 (1024d, higher quality, bigger)
# hash    = deterministic hashing embedder (tests only, no model download)
DEHKHODA_EMBEDDER=e5-base
# Must match the embedder: e5-base=768, bge-m3=1024, hash=256
DEHKHODA_DENSE_DIM=768

# --- Persian analyzer engine ---------------------------------
# hazm (primary, best quality) | parsivar (speed fallback) | regex (last resort)
DEHKHODA_ANALYZER_ENGINE=hazm

# --- BM25 / fusion -------------------------------------------
DEHKHODA_BM25_K1=1.5
DEHKHODA_BM25_B=0.75
DEHKHODA_RRF_K=60

# --- Ingestion ------------------------------------------------
DEHKHODA_DATA_DIR=./data
DEHKHODA_BATCH_SIZE=2000
DEHKHODA_CHUNK_CHARS=1200
DEHKHODA_CHUNK_OVERLAP=150

# --- Search defaults ------------------------------------------
DEHKHODA_TOP_K=8

# --- Docker Compose volumes (used by docker-compose.yml) ------
DEHKHODA_VOLUME_DIR=./volumes
