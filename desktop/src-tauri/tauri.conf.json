{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dehkhoda RAG",
  "version": "1.2.1",
  "identifier": "ir.dehkhoda.rag",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "دهخدا — واژه‌یاب معنایی",
        "width": 1040,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/dehkhoda-server/": "dehkhoda-server/"
    },
    "externalBin": [
      "resources/sidecars/qdrant/qdrant"
    ],
    "category": "Reference",
    "shortDescription": "Hybrid semantic search over the Dehkhoda Dictionary",
    "longDescription": "Persian RAG application over the 312,507-entry Dehkhoda Dictionary with dense + BM25 hybrid search (RRF). Self-contained by default: bundled Qdrant engine (no Docker, no installs); Milvus Standalone via Docker is an optional advanced mode."
  }
}
